{
    "_comment": "Limits for the ci-scale run in CI (scripts/perf/run.mjs --scale=ci --runs=3). Timings are medians in ms on a GitHub-hosted runner. Lower a limit when a change makes a number better; raise one only with a reason in the pull request.",
    "bundle": {
        "initialGzipKB": {
            "max": 365
        },
        "totalGzipKB": {
            "max": 870
        }
    },
    "cold": {
        "signInToListMs": {
            "max": 2000
        },
        "longTaskMs": {
            "max": 2500
        }
    },
    "warm": {
        "reloadToListMs": {
            "max": 1500
        }
    },
    "switch": {
        "firstOpenMedianMs": {
            "max": 1500
        },
        "revisitMedianMs": {
            "max": 800
        },
        "rowClickMedianMs": {
            "max": 2000
        }
    },
    "long": {
        "lastPageMs": {
            "max": 3000
        },
        "appendWithLongHistoryMs": {
            "max": 1500
        }
    },
    "tracker": {
        "projectsReadyMs": {
            "max": 1500
        },
        "missionReadyMs": {
            "max": 1000
        }
    },
    "stream": {
        "short.maxLongTaskMs": {
            "max": 3500
        },
        "long.maxLongTaskMs": {
            "max": 3500
        }
    },
    "soak": {
        "heapGrowthPerCycleMB": {
            "max": 1
        }
    }
}
